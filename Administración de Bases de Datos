ALTER TABLE dbo.Sucursales
ADD CONSTRAINT FK_Sucursales_Encargado FOREIGN KEY (Id_Encargado) REFERENCES dbo.Empleados(Id_Empleado);
SELECT 
    s.Id_Sucursal,
    s.Nombre_Sucursal,
    e.Nombre AS Nombre_Encargado,
    s.Ciudad,
    s.Estado,
    s.Telefono
FROM dbo.Sucursales s
LEFT JOIN dbo.Empleados e ON s.Id_Encargado = e.Id_Empleado;
SELECT 
    e.Id_Empleado,
    e.Nombre AS Nombre_Empleado,
    e.Edad,
    e.Email,
    s.Nombre_Sucursal
FROM dbo.Empleados e
INNER JOIN dbo.Sucursales s ON e.Id_Sucursal = s.Id_Sucursal;
SELECT 
    s.Nombre_Sucursal,
    COUNT(e.Id_Empleado) AS Total_Empleados
FROM dbo.Sucursales s
LEFT JOIN dbo.Empleados e ON s.Id_Sucursal = e.Id_Sucursal
GROUP BY s.Nombre_Sucursal;
SELECT 
    e.Id_Empleado,
    e.Nombre,
    e.Email,
    e.Telefono
FROM dbo.Empleados e
WHERE e.Id_Sucursal = 1;
