CREATE DATABASE GestionEmpleadosUNI;
GO
USE GestionEmpleadosUNI;
GO
CREATE TABLE CentrosTrabajo (
    NumCentro VARCHAR(10) NOT NULL PRIMARY KEY,
    NombreCentro VARCHAR(100) NOT NULL,
    Ciudad VARCHAR(50) NOT NULL
);
GO
CREATE TABLE Empleados (
    NumEmpleado INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    Nombre VARCHAR(50) NOT NULL,
    ApellidoPaterno VARCHAR(50) NOT NULL,
    ApellidoMaterno VARCHAR(50) NOT NULL,
    FechaNacimiento DATE NOT NULL,
    RFC VARCHAR(13) NOT NULL,
    NumCentro VARCHAR(10) NOT NULL,
    Puesto VARCHAR(50) NOT NULL,
    DescripcionPuesto VARCHAR(150) NOT NULL,
    EsDirectivo BIT NOT NULL DEFAULT 0,
    CONSTRAINT FK_Empleados_CentrosTrabajo FOREIGN KEY (NumCentro) 
        REFERENCES CentrosTrabajo(NumCentro)
);
GO
CREATE TABLE Directivos (
    NumEmpleado INT NOT NULL PRIMARY KEY,
    NumCentroSupervisado VARCHAR(10) NOT NULL,
    ApoyoCombustible BIT NOT NULL DEFAULT 0,
    CONSTRAINT FK_Directivos_Empleados FOREIGN KEY (NumEmpleado) 
        REFERENCES Empleados(NumEmpleado),
    CONSTRAINT FK_Directivos_CentrosSupervisado FOREIGN KEY (NumCentroSupervisado) 
        REFERENCES CentrosTrabajo(NumCentro)
);
GO
