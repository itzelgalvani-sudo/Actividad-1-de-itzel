// Función para imprimir el catálogo de puestos / centros de trabajo
void imprimirTablaCentros() {
    cout << "=========================================================================================" << endl;
    cout << "                            TABLA: CATALOGO DE CENTROS DE TRABAJO                        " << endl;
    cout << "=========================================================================================" << endl;
