    cout << "\n=======================================================================================================================" << endl;
    cout << "                                              TABLA: EMPLEADOS GENERALES                                               " << endl;
    cout << "=======================================================================================================================" << endl;
    cout << left 
         << setw(8)  << "No.Emp" 
         << setw(15) << "Nombre" 
         << setw(15) << "Ap. Paterno" 
         << setw(15) << "Ap. Materno" 
         << setw(12) << "F. Nac" 
         << setw(14) << "RFC" 
         << setw(10) << "Centro" 
         << setw(15) << "Puesto" 
         << setw(10) << "Directivo" << endl;
    cout << "-----------------------------------------------------------------------------------------------------------------------" << endl;
    cout << " ( Sin registros / Tabla vacia ) " << endl;
    cout << "-----------------------------------------------------------------------------------------------------------------------\n" << endl;
}

